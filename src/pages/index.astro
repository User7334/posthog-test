---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import ABTest from '../components/ABTest.astro';
---

<Layout>
	<Welcome />
	<ABTest
	id="homepage-hero-abtest"
	key={import.meta.env.PUBLIC_POSTHOG_KEY}
	host={import.meta.env.PUBLIC_POSTHOG_HOST}
	weightA={0.5}
	>
		<Fragment slot="A">
			<section style="background: lightblue; padding: 2rem">
			<h2>Hero A</h2>
			<button data-track="heroA-button">Klick A</button>
			</section>
		</Fragment>

		<Fragment slot="B">
			<section style="background: lightcoral; padding: 2rem">
			<h2>Hero B</h2>
			<button data-track="heroB-button">Klick B</button>
			</section>
		</Fragment>
	</ABTest>
</Layout>
