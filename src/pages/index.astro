---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import ABTest from '../components/ABTest.astro';
import PostHogButton from '../components/PostHogButton.astro';
---

<Layout>
	<div class="flex flex-col mx-5">
		<Welcome />
		<h2>AB-Test</h2>
		<button class="main-button max-w-fit">Click me!</button>
		<h2>New AB Test</h2>
		<ABTest flag="buttonexperiment">
			<button class="text-green-500 border-2 rounded-xl" slot="control">Button Control</button>
			<button class="text-red-500 border-2 rounded-xl" slot="test">Button Test</button>
		</ABTest>
		<ABTest flag="heroexperiment">
			<div class="text-green-500" slot="control">Hero Control</div>
			<div class="text-red-500" slot="test">Hero Test</div>
		</ABTest>
		<PostHogButton flag="button_clicked" experiments={['buttonexperiment']}>
			<div class="bg-amber-600 text-white w-fit rounded-full border-2 border-amber-700 px-2 hover:bg-amber-700 cursor-pointer">Capture</div>
		</PostHogButton>
	</div>  
</Layout>
