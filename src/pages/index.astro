---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import ABTest from '../components/ABTest.astro';
---

<Layout>
	<div class="flex flex-col">
		<Welcome />
		<h2>AB-Test</h2>
		<button class="main-button max-w-fit">Click me!</button>
		<h2>New AB Test</h2>
		<ABTest flag="buttonexperiment">
			<div class="text-green-500" slot="control">Button Control</div>
			<div class="text-red-500" slot="test">Button Test</div>
		</ABTest>
	</div>  
</Layout>
