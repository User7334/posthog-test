---
type Props = {
  experiments: string[];
  flag: string;
};

const { experiments, flag }: Props = Astro.props;

// Wir speichern die Flags als JSON, damit es sauber übertragen wird
const attrFlags = JSON.stringify(experiments);
---

<button 
  class="posthog-button w-fit"
  data-ph-flags={attrFlags}
  data-flag={flag}
>
  <slot />
</button>

<script is:inline>
    document.addEventListener("click", function (event) {
        console.log("clicked");
        const targetEl = event.target;
        if (!targetEl) return;

        console.log("clicked targetEl");

        const button = targetEl.closest(".posthog-button");
        if (!button) return;

        console.log("PostHogButton clicked");

        const raw = button.getAttribute("data-ph-flags");
        const featureFlag = button.getAttribute("data-flag");

        if (!featureFlag) {
            console.error("No feature flag specified on PostHogButton.");
            return;
        }

        let flags = [];
        try {
            flags = JSON.parse(raw || "[]");
        } catch (e) {
            console.error("Invalid flags:", raw);
            return;
        }

        if (!window.posthog) {
            console.warn("PostHog not initialized yet.");
            return;
        }

        flags.forEach((flag) => {
            if (window.posthog) window.posthog.capture(featureFlag, { flag });
        });

        console.log("Captured");
    });
</script>
