---
const { flag = 'button-variants', control = 'Control variant', test = 'Test variant' } = Astro.props;
const id = `abtest-${Math.random().toString(36).slice(2,9)}`;
---

<button class="abtest-button text-red-500" data-abtest-id={id} data-flag={flag} data-control={control} data-test={test}>
  {control}
</button>

<script type="module" is:inline>
  // This script runs client-side and applies a feature-flag-driven variant
  // to the button rendered by this component. It is robust for many instances.
  function addDebug(msg) {
    try {
      const c = document.getElementById('posthog-debug');
      if (c) {
        const el = document.createElement('div');
        el.textContent = new Date().toISOString() + ' — ABTest: ' + msg;
        el.style.padding = '2px 0';
        c.appendChild(el);
        return;
      }
    } catch (e) {
      /* ignore */
    }
    console.debug('ABTest:', msg);
  }

  // Robustly find the button this script belongs to.
  // Prefer the previousElementSibling of the current script (the button we render just above),
  // otherwise fall back to the first element with `data-abtest-id` nearby.
  let button = null;
  try {
    const scriptEl = document.currentScript || (function(){const s=document.getElementsByTagName('script'); return s[s.length-1];})();
    const prev = scriptEl && scriptEl.previousElementSibling;
    if (prev && (prev.matches?.('.abtest-button') || prev.hasAttribute?.('data-abtest-id'))) {
      button = prev;
    } else {
      // fallback: try to find a nearby element with data-abtest-id
      button = document.querySelector('[data-abtest-id]');
    }
  } catch (e) {
    /* ignore */
  }
  if (!button) {
    console.warn('ABTest: button element not found');
    addDebug('button element not found');
  }

  // If a stored assignment exists in localStorage, apply it immediately (sticky)
  try {
    const flagNamePre = button?.dataset?.flag;
    if (flagNamePre) {
      const stored = localStorage.getItem(`abtest-${flagNamePre}`);
      if (false) {
        addDebug(`found stored variant for ${flagNamePre}: ${stored} - applying immediately`);
        if (stored === 'control') {
          button.innerText = button.dataset.control;
          button.classList.add('text-blue-500');
        } else if (stored === 'test') {
          button.innerText = button.dataset.test;
          button.classList.add('text-green-500');
        }
      }
    }
  } catch (e) {
    /* ignore storage errors */
  }

  function applyVariant(posthogInstance) {
    try {
      if (!button) return;
      const flagName = button.dataset.flag;
      const val = posthogInstance?.getFeatureFlag ? posthogInstance.getFeatureFlag(flagName) : undefined;
      addDebug('feature flag value for ' + flagName + ': ' + String(val));
      if (val === 'control') {
        button.innerText = button.dataset.control;
        button.classList.add('text-blue-500');
        addDebug('applied control variant');
        try { localStorage.setItem(`abtest-${flagName}`, 'control'); } catch (e) {}
      } else if (val === 'test') {
        button.innerText = button.dataset.test;
        button.classList.add('text-green-500');
        addDebug('applied test variant');
        try { localStorage.setItem(`abtest-${flagName}`, 'test'); } catch (e) {}
      } else {
        addDebug('no matching variant (value: ' + String(val) + ')');
      }
    } catch (e) {
      console.warn('ABTest: error applying variant', e);
      addDebug('error applying variant: ' + (e && e.message ? e.message : String(e)));
    }
  }

  // Run when posthog is ready
  if (window.__posthogLoaded && window.posthog) {
    addDebug('posthog already loaded - applying variant immediately for ' + abtestId);
    applyVariant(window.posthog);
  } else if (window.posthogReady && typeof window.posthogReady.then === 'function') {
    addDebug('waiting for window.posthogReady promise for ' + abtestId);
    window.posthogReady.then((ph) => {
      addDebug('posthogReady resolved in ABTest for ' + abtestId);
      applyVariant(ph);
    }).catch((e) => {
      addDebug('posthogReady promise rejected: ' + String(e));
    });
  } else {
    addDebug('listening for posthog:loaded event for ' + abtestId);
    window.addEventListener('posthog:loaded', (ev) => {
      addDebug('posthog:loaded event received in ABTest for ' + abtestId);
      applyVariant(ev.detail || window.posthog);
    }, { once: true });
  }
</script>
