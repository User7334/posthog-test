---
interface Props {
  id: string;
}

const { id } = Astro.props;

const hasA = Astro.slots.has('A');
const hasB = Astro.slots.has('B');
if (!hasA || !hasB) {
  throw new Error(`[ABTest:${id}] Both slots "A" and "B" must be defined.`);
}

const slotA = await Astro.slots.render('A');
const slotB = await Astro.slots.render('B');
---

<div class="abtest" data-ab-test-id={id}>
  <div data-variant="A" set:html={slotA}></div>
  <div data-variant="B" hidden set:html={slotB}></div>
</div>

<script type="module">
  // kleine Helper: warte, bis window.posthog existiert (falls Loader minimal später lädt)
  function waitForPosthog(timeout = 4000) {
    return new Promise((resolve, reject) => {
      const start = Date.now();
      (function check() {
        if (window.posthog) return resolve(window.posthog);
        if (Date.now() - start > timeout) return reject(new Error("PostHog timeout"));
        requestAnimationFrame(check);
      })();
    });
  }

  (async () => {
    // robustes Targeting: an nächstes .abtest-Element anhängen
    const root = document.currentScript?.closest('.abtest') || document.querySelector('.abtest');
    if (!root) return;

    const flagKey = root.dataset.abTestId;

    let ph;
    try { ph = await waitForPosthog(); } catch { return; }

    // Stelle sicher, dass Flags geladen sind, dann Variante bestimmen
    ph.onFeatureFlags(async () => {
      let variant = 'A';
      try {
        const res = await ph.getFeatureFlag(flagKey);
        if (res === 'B') variant = 'B';
      } catch {}

      const a = root.querySelector('[data-variant="A"]');
      const b = root.querySelector('[data-variant="B"]');
      if (a && b) {
        a.hidden = variant !== 'A';
        b.hidden = variant !== 'B';
      }

      ph.capture('ab_test_variant_assigned', {
        id: flagKey,
        variant,
        page: window.location.pathname,
        ts: Date.now(),
      });
    });
  })();
</script>
