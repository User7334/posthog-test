---
const { flag = 'button-variants', control = 'Control variant', test = 'Test variant' } = Astro.props;
const id = `abtest-${Math.random().toString(36).slice(2,9)}`;
---

<button class="abtest-button text-red-500" data-abtest-id={id} data-flag={flag} data-control={control} data-test={test}>
  {control}
</button>

<script type="module" is:inline>
  // This script runs on the client when the component is loaded.
  // It waits for PostHog to be ready (via promise, event, or immediate) and
  // then applies the variant to the button rendered above.
  function addDebug(msg) {
    try {
      const c = document.getElementById('posthog-debug');
      if (c) {
        const el = document.createElement('div');
        el.textContent = new Date().toISOString() + ' — ABTest: ' + msg;
        el.style.padding = '2px 0';
        c.appendChild(el);
        return;
      }
    } catch (e) {
      /* ignore */
    }
    console.debug('ABTest:', msg);
  }

  // Each instance has a unique id generated server-side and set as attribute
  const abtestId = '{id}';
  let button;
  try {
    // Find the specific button by its data attribute using the embedded id
    button = document.querySelector(`[data-abtest-id="${abtestId}"]`);
  } catch (e) {
    /* ignore */
  }
  if (!button) {
    console.warn('ABTest: button element not found for id', abtestId);
    addDebug('button element not found for id ' + abtestId);
  }

  if (!button) {
    console.warn('ABTest: button element not found');
    addDebug('button element not found');
  }

  function applyVariant(posthogInstance) {
    try {
      if (!button) return;
      const flagName = button.dataset.flag;
      const val = posthogInstance?.getFeatureFlag ? posthogInstance.getFeatureFlag(flagName) : undefined;
      addDebug('feature flag value: ' + String(val));
      if (val === 'control') {
        button.innerText = button.dataset.control;
        button.classList.add('text-blue-500');
        addDebug('applied control variant');
        // Optional: persist to localStorage
        try {
          localStorage.setItem(`abtest-${flagName}`, 'control');
        } catch (e) { /* ignore localStorage errors */ }
      } else if (val === 'test') {
        button.innerText = button.dataset.test;
        button.classList.add('text-green-500');
        addDebug('applied test variant');
        // Optional: persist to localStorage
        try {
          localStorage.setItem(`abtest-${flagName}`, 'test');
        } catch (e) { /* ignore localStorage errors */ }
      } else {
        addDebug('no matching variant (value: ' + String(val) + ')');
      }
    } catch (e) {
      console.warn('ABTest: error applying variant', e);
      addDebug('error applying variant: ' + (e && e.message ? e.message : String(e)));
    }
  }

  // If already marked as loaded, run immediately
  if (window.__posthogLoaded && window.posthog) {
    addDebug('posthog already loaded - applying variant immediately');
    applyVariant(window.posthog);
  } else if (window.posthogReady && typeof window.posthogReady.then === 'function') {
    // Prefer awaiting the shared promise when available
    addDebug('waiting for window.posthogReady promise');
    window.posthogReady.then((ph) => {
      addDebug('posthogReady resolved in ABTest');
      applyVariant(ph);
    }).catch((e) => {
      addDebug('posthogReady promise rejected: ' + String(e));
    });
  } else {
    // Fallback to listening to a custom event
    addDebug('listening for posthog:loaded event');
    window.addEventListener('posthog:loaded', (ev) => {
      addDebug('posthog:loaded event received in ABTest');
      applyVariant(ev.detail || window.posthog);
    }, { once: true });
  }
</script>
