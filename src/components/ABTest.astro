---
interface Props {
  id: string;          // Feature-Flag-Key in PostHog
  key: string;         // PUBLIC_POSTHOG_KEY
  host: string;        // PUBLIC_POSTHOG_HOST
  weightA?: number;    // z. B. 0.5
}

const { id, key, host, weightA = 0.5 } = Astro.props;
const slotA = await Astro.slots.render("A");
const slotB = await Astro.slots.render("B");
---

<div
  data-abtest
  data-id={id}
  data-key={key}
  data-host={host}
  data-weight={String(weightA)}
>
  <div data-variant="A" hidden><Fragment set:html={slotA} /></div>
  <div data-variant="B" hidden><Fragment set:html={slotB} /></div>
</div>
