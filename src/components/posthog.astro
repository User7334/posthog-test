  // Werte werden zur Build-Zeit durch Vite/Astro ersetzt. Stelle sicher, dass
  // die Variablen als `PUBLIC_...` in Vercel gesetzt sind.
  const KEY = import.meta.env.PUBLIC_POSTHOG_KEY;
  const HOST = import.meta.env.PUBLIC_POSTHOG_HOST;

  if (!KEY || !HOST) {
    console.warn('PostHog: PUBLIC_POSTHOG_KEY oder PUBLIC_POSTHOG_HOST ist nicht gesetzt. PostHog wird nicht initialisiert.');
  } else {
    // Optional: Log zum Debuggen ob Werte korrekt eingebunden wurden
    console.debug('PostHog init key/host:', KEY ? 'present' : 'missing', HOST);

    posthog.init(KEY, {
      api_host: HOST,
      defaults: '2025-05-24',
      loaded: (posthog) => {
        console.debug('PostHog loaded callback fired');
        posthog.onFeatureFlags(() => {
          const button = document.querySelector('.main-button');
          if (!button) return;
          const flag = posthog.getFeatureFlag('button-variants');
          if (flag === 'control') {
              button.innerText = 'Control variant';
          } else if (flag === 'test') {
              button.innerText = 'Test variant';
          }
        });
      }
    });
