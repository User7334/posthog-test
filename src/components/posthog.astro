  // --- simple on-page debug UI helpers ---
  function ensureDebugContainer() {
    try {
      let c = document.getElementById('posthog-debug');
      if (c) return c;
      c = document.createElement('div');
      c.id = 'posthog-debug';
      c.style.cssText = 'position:fixed;bottom:12px;right:12px;max-width:360px;max-height:40vh;overflow:auto;font-family:monospace;font-size:12px;background:rgba(0,0,0,0.8);color:#fff;padding:8px;border-radius:6px;z-index:99999;pointer-events:auto;';
      const title = document.createElement('div');
      title.style.cssText = 'font-weight:600;margin-bottom:6px;font-size:12px';
      title.textContent = 'PostHog debug';
      c.appendChild(title);
      document.body.appendChild(c);
      return c;
    } catch (e) {
      console.debug('ensureDebugContainer failed', e);
      return null;
    }
  }

  function addDebug(msg) {
    try {
      const c = ensureDebugContainer();
      if (!c) return;
      const el = document.createElement('div');
      el.textContent = new Date().toISOString() + ' — ' + msg;
      el.style.padding = '2px 0';
      c.appendChild(el);
    } catch (e) {
      console.debug('addDebug failed', e);
    }
  }

  // Setup a promise + resolver so other components can `await` posthog being ready
  if (!window.posthogReady) {
    let _resolve;
    window.posthogReady = new Promise((resolve) => { _resolve = resolve; });
    window.__posthogResolve = _resolve;
    addDebug('posthogReady promise created');
  }

  addDebug('calling posthog.init');

  const KEY = import.meta.env.PUBLIC_POSTHOG_KEY || import.meta.env.VITE_PUBLIC_POSTHOG_KEY || 'phc_KOcWjzbh56k1BfKTHlPJD0PGavdy7gMd7qVME4syB40';
  const HOST = import.meta.env.PUBLIC_POSTHOG_HOST || import.meta.env.VITE_PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
  if (!KEY) {
    addDebug('PUBLIC_POSTHOG_KEY not set - skipping init');
    console.warn('PostHog public key not set (PUBLIC_POSTHOG_KEY)');
  } else {
    posthog.init(KEY, {
      api_host: HOST,
      defaults: '2025-05-24',
      persistence: 'localStorage',  // use localStorage for persistent session state
      loaded: (posthog) => {
        // Important: wait for onFeatureFlags to ensure flags are actually loaded
        posthog.onFeatureFlags(() => {
          addDebug('posthog.onFeatureFlags() fired - flags are ready');
          try {
            window.__posthogLoaded = true;
            if (window.__posthogResolve) {
              window.__posthogResolve(posthog);
              addDebug('window.__posthogResolve() successful (after flags loaded)');
            } else {
              addDebug('window.__posthogResolve not present');
            }
          } catch (e) {
            console.warn('PostHog: could not set ready promise', e);
            addDebug('window.__posthogResolve() failed: ' + (e && e.message ? e.message : String(e)));
          }
          try {
            window.dispatchEvent(new CustomEvent('posthog:loaded', { detail: posthog }));
            addDebug('posthog:loaded dispatched (after flags loaded)');
          } catch (e) {
            /* ignore */
          }
        });
      }
    })
  }
